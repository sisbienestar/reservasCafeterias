# Copia esto a .env.local y rellena con los valores del proyecto de Supabase.
# .env.local esta en .gitignore y NO debe subirse nunca.

# ── Servidor (las funciones de /api) ─────────────────────────────────────
# La clave de SERVICIO se salta RLS por completo: puede leer y escribir todo
# el campus. Solo puede vivir en las variables de entorno de Vercel, y solo en
# las de servidor. Si acaba en una variable VITE_*, viaja al navegador.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Quien puede llamar a la API desde un navegador, separado por comas.
# Sin esto no se responde a nadie con credenciales.
ORIGENES_PERMITIDOS=http://localhost:5173,https://TU-APP.vercel.app

# ── INTERRUPTOR TEMPORAL DE PRUEBAS ──────────────────────────────────────
# En 'true' se levanta la regla de que sabados y domingos no hay servicio.
# DEBE ESTAR EN 'false' EN PRODUCCION.
PERMITIR_FIN_DE_SEMANA=false

# ── Cliente (lo que Vite mete en el paquete del navegador) ───────────────
# Estas DOS son publicas por diseno y no pasa nada porque se vean: la anonima
# no abre ninguna puerta mientras 02-rls.sql siga cerrado.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=/api

# El dominio con el que se completan los nombres de usuario. Nadie lo teclea:
# es lo que le falta a «gloria» para ser gloria@reservas.uis, que es el
# correo con el que la cuenta esta dada de alta en Supabase.
VITE_DOMINIO_USUARIOS=reservas.uis
